{
  "info": {
    "name": "OrderApi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] } }
        },
        {
          "name": "Create Customer",
          "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\"\n}" }, "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] } }
        },
        {
          "name": "Get Customer By Id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/customers/1", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1"] } }
        },
        {
          "name": "Delete Customer",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/customers/1", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1"] } }
        },
        {
          "name": "Get Order History",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/customers/1/order-history", "host": ["{{baseUrl}}"], "path": ["api", "customers", "1", "order-history"] } }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }
        },
        {
          "name": "Create Product",
          "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"unitPrice\": 1200.50,\n  \"stockQuantity\": 50\n}" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }
        },
        {
          "name": "Get Product By Id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] } }
        },
        {
          "name": "Update Product",
          "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"unitPrice\": 1500.00,\n  \"stockQuantity\": 10\n}" }, "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] } }
        },
        {
          "name": "Delete Product",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] } }
        },
        {
          "name": "Get Low Stock Products",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products/low-stock", "host": ["{{baseUrl}}"], "path": ["api", "products", "low-stock"] } }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get All Orders",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] } }
        },
        {
          "name": "Create Order",
          "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}" }, "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] } }
        },
        {
          "name": "Get Order By Id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/orders/1", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1"] } }
        },
        {
          "name": "Ship Order",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/api/orders/1/ship", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1", "ship"] } }
        },
        {
          "name": "Deliver Order",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/api/orders/1/deliver", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1", "deliver"] } }
        },
        {
          "name": "Cancel Order",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/api/orders/1/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1", "cancel"] } }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Top Customers",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports/top-customers", "host": ["{{baseUrl}}"], "path": ["api", "reports", "top-customers"] } }
        },
        {
          "name": "Get Best Selling Products",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports/best-selling-products", "host": ["{{baseUrl}}"], "path": ["api", "reports", "best-selling-products"] } }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7121",
      "type": "string"
    }
  ]
}
